{
  "openapi": "3.1.0",
  "info": {
    "title": "AGYNEXA implemented public API",
    "version": "2026-10-20",
    "description": "Current site APIs: catalog, illustrative procurement, read-only Supabase health, individual authentication and persistent owner-only project briefs. No agent runtime or knowledge API. Stage-3 openapi.yaml is a separate proposal."
  },
  "servers": [
    {
      "url": "https://vzero-nine-beryl.vercel.app",
      "description": "Public production domain; may advance to later releases"
    },
    {
      "url": "http://localhost:3011",
      "description": "Local development when started on port 3011"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/catalog/services": {
      "get": {
        "operationId": "getPublishedServiceCatalog",
        "summary": "Read the local bilingual service catalog",
        "x-implementation-status": "IMPLEMENTED",
        "description": "Public projection only. No custom distributed quota. An absent or empty lang selects en; an unsupported non-empty value returns 400. This envelope differs from the stage-3 proposed array.",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar",
                ""
              ],
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=300"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported non-empty lang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "lang must be en or ar"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/procurement/review": {
      "post": {
        "operationId": "reviewIllustrativeProcurement",
        "summary": "Calculate a fictional quote comparison",
        "x-implementation-status": "IMPLEMENTED",
        "x-max-body-bytes": 2048,
        "description": "Quantity, whole-USD budget and supplier B warranty only. Supplier A fixed at USD 1200/unit, 24 months; B at USD 1180/unit. No supplier verification, order creation, authenticated approval or persistence. Missing Origin is accepted; cross-origin Origin is rejected. Handler checks streamed size, not only Content-Length. No custom distributed rate limit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInput"
              },
              "example": {
                "quantity": 12,
                "budget": 15000,
                "warrantyMonths": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculation result, possibly requiring clarification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResult"
                },
                "example": {
                  "mode": "ILLUSTRATIVE",
                  "currency": "USD",
                  "input": {
                    "quantity": 12,
                    "budget": 15000,
                    "warrantyMonths": null
                  },
                  "quotes": [
                    {
                      "id": "A",
                      "unitPrice": 1200,
                      "warrantyMonths": 24,
                      "total": 14400,
                      "withinBudget": true,
                      "complete": true
                    },
                    {
                      "id": "B",
                      "unitPrice": 1180,
                      "warrantyMonths": null,
                      "total": 14160,
                      "withinBudget": true,
                      "complete": false
                    }
                  ],
                  "issues": [
                    {
                      "supplier": "B",
                      "code": "MISSING_WARRANTY"
                    }
                  ],
                  "status": "CLARIFICATION_REQUIRED",
                  "orderCreated": false,
                  "policy": "Compare prices only after warranty and budget checks; a responsible person must decide."
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            }
          },
          "400": {
            "description": "Missing body, malformed JSON, invalid input or body read error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            }
          },
          "403": {
            "description": "Present Origin header does not equal request URL origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 2048 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type does not start with application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method, including GET. Framework-generated; no custom JSON error shape is guaranteed."
          }
        }
      }
    },
    "/api/health/supabase": {
      "get": {
        "operationId": "checkSupabaseConnection",
        "summary": "Verify both configured keys against the owner-selected Supabase project",
        "description": "GETs /auth/v1/settings with the publishable key and /rest/v1/ with the secret key (REST root rejects publishable keys); no table rows read or written. Pins xsyxvswbiptbyxyqhdim.supabase.co and refuses redirects. Never returns keys or upstream response bodies. Five-second timeout per request, no-store. HTTP 200 only if both keys authenticate; 503 for missing/invalid configuration, wrong project, denied access or network failure. Does not prove schema, RLS or application workflows. Response includes safe diagnostic enums only: project (ok/missing/invalid); publishableKey and secretKey (ok/missing/invalid_format/rejected/unreachable/not_checked). No variable values or upstream response bodies.",
        "responses": {
          "200": {
            "description": "Both credentials accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "project",
                        "publishableKey",
                        "secretKey"
                      ],
                      "properties": {
                        "project": {
                          "enum": [
                            "ok",
                            "missing",
                            "invalid"
                          ]
                        },
                        "publishableKey": {
                          "enum": [
                            "ok",
                            "missing",
                            "invalid_format",
                            "rejected",
                            "unreachable",
                            "not_checked"
                          ]
                        },
                        "secretKey": {
                          "enum": [
                            "ok",
                            "missing",
                            "invalid_format",
                            "rejected",
                            "unreachable",
                            "not_checked"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Connection not established",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "project",
                        "publishableKey",
                        "secretKey"
                      ],
                      "properties": {
                        "project": {
                          "enum": [
                            "ok",
                            "missing",
                            "invalid"
                          ]
                        },
                        "publishableKey": {
                          "enum": [
                            "ok",
                            "missing",
                            "invalid_format",
                            "rejected",
                            "unreachable",
                            "not_checked"
                          ]
                        },
                        "secretKey": {
                          "enum": [
                            "ok",
                            "missing",
                            "invalid_format",
                            "rejected",
                            "unreachable",
                            "not_checked"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Create and sign in without confirmation email",
        "description": "Private no-store responses. Mutations require same Origin and JSON <=20KB. Errors contain stable codes only. Rate-limited by server; credentials never returned.",
        "responses": {
          "201": {
            "description": "Created and signed in"
          },
          "400": {
            "description": "Invalid or unavailable registration"
          },
          "403": {
            "description": "Wrong origin"
          },
          "413": {
            "description": "Too large"
          },
          "415": {
            "description": "JSON required"
          },
          "429": {
            "description": "Too many attempts"
          },
          "503": {
            "description": "Unavailable or created_sign_in_required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "name"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 12
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "login",
        "description": "Private no-store responses. Mutations require same Origin and JSON <=20KB. Errors contain stable codes only. Rate-limited by server; credentials never returned.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid email or password; generic response"
          },
          "403": {
            "description": "Wrong origin"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Unavailable"
          },
          "413": {
            "description": "Body exceeds 20KB"
          },
          "415": {
            "description": "JSON required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "logout",
        "description": "End the current local session using Supabase signOut. No explicit getUser guard; a missing session is not documented as an authenticated action. Same-origin JSON mutation <=20KB. Private no-store responses. No application login/signup rate limiter is called here.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Wrong origin"
          },
          "503": {
            "description": "Unavailable"
          },
          "413": {
            "description": "Body exceeds 20KB"
          },
          "415": {
            "description": "JSON required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "security": [
          {},
          {
            "supabaseSession": []
          }
        ]
      }
    },
    "/api/account": {
      "get": {
        "summary": "Return own display name, email and account creation date",
        "description": "Requires a server-validated session. Owner and active-session RLS apply. Private no-store response.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Sign in required"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "supabaseSession": []
          }
        ]
      }
    },
    "/api/v1/project-briefs": {
      "get": {
        "summary": "List latest 100 own briefs",
        "description": "Requires a server-validated session. Owner and active-session RLS apply. Private no-store response.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Sign in required"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "supabaseSession": []
          }
        ]
      },
      "post": {
        "summary": "Save own brief with explicit consent; same key/body returns original, different body conflicts",
        "description": "Private no-store responses. Mutations require same Origin and JSON <=20KB. Errors contain stable codes only. Requires validated HttpOnly session; owner/session RLS applies.",
        "responses": {
          "201": {
            "description": "Saved"
          },
          "200": {
            "description": "Idempotent replay"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Wrong origin"
          },
          "409": {
            "description": "Key reused for different body"
          },
          "413": {
            "description": "Too large"
          },
          "415": {
            "description": "JSON required"
          },
          "429": {
            "description": "20 existing briefs created within the last 24 hours; deletion frees capacity. This is not a cumulative create-attempt quota."
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestKey",
                  "organization",
                  "email",
                  "service",
                  "problem",
                  "sources",
                  "acceptance",
                  "consent"
                ],
                "properties": {
                  "requestKey": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "consent": {
                    "const": true
                  },
                  "organization": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 254,
                    "format": "email"
                  },
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "problem": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "sources": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "acceptance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "supabaseSession": []
          }
        ]
      },
      "delete": {
        "summary": "Delete own brief; inaccessible IDs return 404",
        "description": "Private no-store responses. Mutations require same Origin and JSON <=20KB. Errors contain stable codes only. Requires validated HttpOnly session; owner/session RLS applies.",
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Wrong origin"
          },
          "404": {
            "description": "No accessible brief"
          },
          "503": {
            "description": "Unavailable"
          },
          "413": {
            "description": "Body exceeds 20KB"
          },
          "415": {
            "description": "JSON required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "supabaseSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Service": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Relative locale-aware page path"
          }
        },
        "required": [
          "slug",
          "title",
          "description",
          "url"
        ]
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ar"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "description": "10 services in the documented release"
          }
        },
        "required": [
          "locale",
          "services"
        ]
      },
      "ReviewInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "warrantyMonths": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 120
          }
        },
        "required": [
          "quantity",
          "budget",
          "warrantyMonths"
        ]
      },
      "Quote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "unitPrice": {
            "type": "integer",
            "enum": [
              1200,
              1180
            ]
          },
          "warrantyMonths": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 120
          },
          "total": {
            "type": "integer",
            "minimum": 1180,
            "maximum": 1200000
          },
          "withinBudget": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "unitPrice",
          "warrantyMonths",
          "total",
          "withinBudget",
          "complete"
        ]
      },
      "Issue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supplier": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "MISSING_WARRANTY",
              "OVER_BUDGET"
            ]
          }
        },
        "required": [
          "supplier",
          "code"
        ]
      },
      "ReviewResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "const": "ILLUSTRATIVE"
          },
          "currency": {
            "const": "USD"
          },
          "input": {
            "$ref": "#/components/schemas/ReviewInput"
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Quote"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "maxItems": 4
          },
          "status": {
            "type": "string",
            "enum": [
              "CLARIFICATION_REQUIRED",
              "READY_FOR_HUMAN_REVIEW"
            ]
          },
          "orderCreated": {
            "const": false
          },
          "policy": {
            "type": "string"
          }
        },
        "required": [
          "mode",
          "currency",
          "input",
          "quotes",
          "issues",
          "status",
          "orderCreated",
          "policy"
        ]
      }
    },
    "securitySchemes": {
      "supabaseSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-xsyxvswbiptbyxyqhdim-auth-token",
        "description": "HttpOnly Supabase SSR session cookie; large values may be split into numbered .0/.1 cookies. Send the complete cookie jar issued by register/login. Server getUser validates identity; data RLS also checks the active session. Never fabricate a cookie or treat email confirmation as proof of email ownership."
      }
    }
  }
}
